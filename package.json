{
  "name": "opencode-zen-provider",
  "publisher": "HidenobuNagai",
  "displayName": "OpenCode Zen Provider for Copilot Chat",
  "description": "OpenCode Zen chat provider for VS Code Copilot Chat",
  "version": "0.1.45",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hidenobunagai/opencode-zen-provider"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1A1A2E",
    "theme": "dark"
  },
  "keywords": [
    "copilot",
    "opencode",
    "zen",
    "chat",
    "gpt",
    "claude",
    "gemini",
    "qwen",
    "minimax"
  ],
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "opencode-zen",
        "displayName": "OpenCode Zen",
        "managementCommand": "opencode-zen.manage"
      }
    ],
    "languageModelTools": [
      {
        "name": "opencode_zen_analyze_image",
        "toolReferenceName": "analyzeImage",
        "displayName": "OpenCode Zen Analyze Image",
        "modelDescription": "Analyze an image with the OpenCode Zen vision model and return a text description.",
        "userDescription": "Analyze an image using OpenCode Zen Vision.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "image_data": {
              "type": "string",
              "description": "Base64-encoded image data URL."
            },
            "prompt": {
              "type": "string",
              "description": "Instruction describing what to analyze in the image."
            }
          },
          "required": [
            "image_data",
            "prompt"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "opencode-zen.manage",
        "title": "Manage OpenCode Zen API Key",
        "category": "OpenCode Zen"
      },
      {
        "command": "opencode-zen.toggleDebugLogging",
        "title": "Toggle Debug Logging",
        "category": "OpenCode Zen"
      },
      {
        "command": "opencode-zen.openDebugLog",
        "title": "Open Debug Log",
        "category": "OpenCode Zen"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "smoke": "bun run scripts/smoke.ts",
    "check-changelog": "bun scripts/check-changelog.ts",
    "sync:pi": "bun scripts/sync-from-pi.ts",
    "sync:pi:write": "bun scripts/sync-from-pi.ts --write",
    "package:vsix": "bun run check-changelog && bun run compile && vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/vscode": "1.104.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {}
}
